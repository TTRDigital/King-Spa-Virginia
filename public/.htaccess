# KING SPA Virginia: static Next.js export on SiteGround (Apache), behind Cloudflare.
# Does what WordPress and its plugins did: one address, https, trailing
# slashes, every old URL (301), security headers, caching and compression.

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
# The trailing slash is added by a rewrite below (on https), not by Apache.
DirectorySlash Off
# A real 404 status with the site's 404 page.
ErrorDocument 404 /404-error/index.html
ErrorDocument 410 /404-error/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- One address: https://virginia.kingspa.com ----
  # The SiteGround temporary address (*.sg-host.com / *.siteground.*), www. and
  # any other host pointed here go to the main domain, path kept.
  # localhost is left alone for testing.
  RewriteCond %{HTTP_HOST} !^virginia\.kingspa\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://virginia.kingspa.com/$1 [R=301,L]

  # http -> https. Cloudflare talks to the server on its own connection, so
  # the visitor's scheme is read from X-Forwarded-Proto / CF-Visitor too:
  # without these checks a "Flexible" Cloudflare setting would loop forever.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP:CF-Visitor} !scheme.{0,4}https [NC]
  RewriteCond %{HTTP_HOST} ^virginia\.kingspa\.com$ [NC]
  RewriteRule ^(.*)$ https://virginia.kingspa.com/$1 [R=301,L]

  # ---- Old URLs (keep above the slash rule) ----

  # /blog/category/<category>/: the live site shows the same page as /blog/category/blog/<category>/
  # there (same canonical); without the slash it adds one.
  RewriteRule ^blog/category/(body-scrubs|facials|korean-spa|massage-guides|plan-your-visit)$ https://%{HTTP_HOST}/blog/category/$1/ [R=301,L,NC]
  RewriteRule ^blog/category/(body-scrubs|facials|korean-spa|massage-guides|plan-your-visit)/$ /blog/category/blog/$1/index.html [L,NC]

  # /blog/page/2/, /blog/page/3/...: the live site shows the blog page again there
  # (its canonical is /blog/); without the slash it adds one.
  RewriteRule ^blog/page/([0-9]+)$ https://%{HTTP_HOST}/blog/page/$1/ [R=301,L,NC]
  RewriteRule ^blog/page/[0-9]+/$ /blog/index.html [L,NC]

  # Redirects the WordPress site already made (Rank Math and WordPress's own
  # "old slug" guesses), each straight to the final page in one step.
  RewriteRule ^about-us/?$ https://%{HTTP_HOST}/about/ [R=301,L,NC]
  RewriteRule ^about-us/areas-we-serve/day-spa-in-maryland/?$ https://%{HTTP_HOST}/areas-we-serve/day-spa-in-maryland/ [R=301,L,NC]
  RewriteRule ^about-us/areas-we-serve/day-spa-in-new-jersey/?$ https://%{HTTP_HOST}/areas-we-serve/day-spa-in-new-jersey/ [R=301,L,NC]
  RewriteRule ^about-us/areas-we-serve/day-spa-in-pennsylvania/?$ https://%{HTTP_HOST}/areas-we-serve/day-spa-in-pennsylvania/ [R=301,L,NC]
  RewriteRule ^about/terms-conditions/?$ https://%{HTTP_HOST}/about/terms-and-conditions/ [R=301,L,NC]
  RewriteRule ^aqua-pool/?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  RewriteRule ^areas-we-serve/?$ https://%{HTTP_HOST}/about/areas-we-serve-2/ [R=301,L,NC]
  RewriteRule ^back-to-school-special/?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  RewriteRule ^blog/24k-gold/?$ https://%{HTTP_HOST}/treatments/facial/24k-gold/ [R=301,L,NC]
  RewriteRule ^blog/about/?$ https://%{HTTP_HOST}/about/ [R=301,L,NC]
  RewriteRule ^blog/aqua-pool/?$ https://%{HTTP_HOST}/explore/korean-bath-spa/aqua-pool/ [R=301,L,NC]
  RewriteRule ^blog/areas-we-serve-2/?$ https://%{HTTP_HOST}/about/areas-we-serve-2/ [R=301,L,NC]
  RewriteRule ^blog/aromatic-massage/?$ https://%{HTTP_HOST}/massage-therapy/aromatic-massage/ [R=301,L,NC]
  RewriteRule ^blog/basic/?$ https://%{HTTP_HOST}/treatments/facial/basic/ [R=301,L,NC]
  RewriteRule ^blog/bath-house/?$ https://%{HTTP_HOST}/explore/korean-bath-spa/bath-house/ [R=301,L,NC]
  RewriteRule ^blog/blog/?$ https://%{HTTP_HOST}/blog/ [R=301,L,NC]
  RewriteRule ^blog/body-scrub-vs-massage/?$ https://%{HTTP_HOST}/blog/can-body-scrub-remove-dark-spots-king-spa-va/ [R=301,L,NC]
  RewriteRule ^blog/body-scrub/?$ https://%{HTTP_HOST}/body-scrub/ [R=301,L,NC]
  RewriteRule ^blog/bubble-body/?$ https://%{HTTP_HOST}/treatments/couples/bubble-body/ [R=301,L,NC]
  RewriteRule ^blog/can-body-scrub-remove-dark-spots-lets-find-out/?$ https://%{HTTP_HOST}/blog/can-body-scrub-remove-dark-spots-king-spa-va/ [R=301,L,NC]
