  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=818(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/explore/saunas-therapy-rooms/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=825(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/about/faq/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=833(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/about/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=9243(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/about/privacy-policy/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=9985(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/vaginal-steaming-pros-and-cons/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)cat=41(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/category/blog/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)cat=49(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/category/blog/korean-spa/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)cat=50(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/category/blog/body-scrubs/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)cat=51(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/category/blog/massage-guides/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)cat=52(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/category/blog/facials/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)cat=53(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/category/blog/plan-your-visit/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)tag_ID=42(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/tag/health-benefits/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)tag_ID=43(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/tag/virginia-king-spa/ [R=301,L,QSD]
  # Any other ?p= / ?page_id= -> home page.
  RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id|cat)=\d+(?:&|$) [NC]
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/ [R=301,L,QSD]
  # /index.php and /index.html -> home page.
  RewriteRule ^index\.(?:php|html?)$ https://%{HTTP_HOST}/ [R=301,L,NC]

  # WordPress uploads -> the same file here (public/images/wp/...). Resized
  # copies (photo-300x200.jpg) and WebP twins (photo.jpg.webp) -> the original.
  RewriteRule ^wp-content/uploads/elementor/google-fonts/fonts/(.+)$ https://%{HTTP_HOST}/fonts/$1 [R=301,L,NC]
  RewriteCond %{DOCUMENT_ROOT}/images/wp/$1 -f
  RewriteRule ^wp-content/uploads/(.+)$ https://%{HTTP_HOST}/images/wp/$1 [R=301,L]
  RewriteCond %{DOCUMENT_ROOT}/images/wp/$1 -f
  RewriteRule ^wp-content/uploads/(.+\.(?:jpe?g|png|gif))\.webp$ https://%{HTTP_HOST}/images/wp/$1 [R=301,L,NC]
  RewriteCond %{DOCUMENT_ROOT}/images/wp/$1$3 -f
  RewriteRule ^wp-content/uploads/(.+?)(-\d+x\d+)?(\.(?:jpe?g|png|gif|webp|svg))(?:\.webp)?$ https://%{HTTP_HOST}/images/wp/$1$3 [R=301,L,NC]

  # Sitemaps, answered as the live site's SEO plugin (Rank Math) answered them:
  # /sitemap_index.xml, /post-, /page-, /category-sitemap.xml are files (lib/sitemaps.ts).
  RewriteRule ^(?:sitemap|wp-sitemap)\.xml$ https://%{HTTP_HOST}/sitemap_index.xml [R=301,L,NC]
  RewriteRule ^wp-sitemap-posts-post-\d+\.xml$ https://%{HTTP_HOST}/post-sitemap.xml [R=301,L,NC]
  RewriteRule ^wp-sitemap-posts-page-\d+\.xml$ https://%{HTTP_HOST}/page-sitemap.xml [R=301,L,NC]
  RewriteRule ^wp-sitemap-taxonomies-category-\d+\.xml$ https://%{HTTP_HOST}/category-sitemap.xml [R=301,L,NC]
  RewriteRule ^wp-sitemap-[a-z0-9_-]+\.xml$ https://%{HTTP_HOST}/sitemap_index.xml [R=301,L,NC]
  RewriteRule ^(post|page|category)-sitemap1\.xml$ /$1-sitemap.xml [L,NC]
  RewriteRule ^(post|page|category)-sitemap(?:[2-9]|\d{2,})\.xml$ https://%{HTTP_HOST}/$1-sitemap.xml [R=302,L,NC]

  # WordPress-only addresses: 410 Gone, so search engines drop them.
  RewriteRule ^(?:wp-admin|wp-includes|wp-json|wp-content)(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback|wp-comments-post|wp-links-opml)\.php$ - [G,L,NC]
  RewriteRule ^(?:.+/)?(?:feed|rss2?|atom|trackback|embed)/?$ - [G,L,NC]
  RewriteRule ^(?:author|comments)/ - [G,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:rest_route|feed|attachment_id|author)= [NC]
  RewriteRule ^(?:index\.php)?$ - [G,L]
  # ---- end of old URLs ----

  # The 404 page (/404-error/; /404.html is Next.js's unused default) only shows as the error
  # page, never as a page of its own with a 200.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(?:404-error(?:/|/index\.html)?|404\.html)$ - [R=404,L]

  # Pages live at /page/ (page/index.html): add the missing slash, on https
  # (absolute, so visitors behind Cloudflare are not bounced through http).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# Never served: the upload tool's file list and the form settings.
<FilesMatch "^(\.ftp-deploy-sync-state\.json|\.config\.php|\.htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP: the site's own files plus what the pages really load: Google Tag
  # Manager (GA4 G-TJDCTQ1MP2, Google Ads) and the gtag for UA-210625545-1,
  # Meta Pixel, Hotjar, Clixtell, Ahrefs, Klaviyo, Google reCAPTCHA and Maps,
  # YouTube, the Elfsight reviews widget and AddToAny. If a new tag is added in
  # Tag Manager that loads another domain, add the domain here.
  # The studio at /cms talks to many Sanity hosts and is protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://pagead2.googlesyndication.com https://*.googlesyndication.com https://www.google.com https://www.gstatic.com https://connect.facebook.net https://static.hotjar.com https://script.hotjar.com https://*.hotjar.com https://scripts.clixtell.com https://*.clixtell.com https://analytics.ahrefs.com https://static.klaviyo.com https://*.klaviyo.com https://elfsightcdn.com https://*.elfsight.com https://*.elfsightcdn.com https://static.addtoany.com https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com https://*.klaviyo.com https://*.elfsight.com https://*.elfsightcdn.com https://static.addtoany.com https://www.gstatic.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://fonts.cdnfonts.com https://*.klaviyo.com https://*.elfsight.com https://*.elfsightcdn.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.doubleclick.net https://www.googleadservices.com https://*.googlesyndication.com https://adservice.google.com https://cct.google https://www.facebook.com https://*.facebook.com https://*.hotjar.com https://*.hotjar.io wss://*.hotjar.com https://*.clixtell.com https://analytics.ahrefs.com https://*.klaviyo.com https://*.elfsight.com https://*.elfsightcdn.com https://static.addtoany.com https://www.youtube.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com https://www.youtube-nocookie.com https://www.googletagmanager.com https://*.doubleclick.net https://td.doubleclick.net https://www.facebook.com https://*.hotjar.com https://*.klaviyo.com https://*.elfsight.com https://*.elfsightcdn.com https://static.addtoany.com; media-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://www.facebook.com; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: build files with hashed names forever, page stylesheets (versioned
  # ?v=), fonts for a year, photos for a month, pages always fresh.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/javascript .js .mjs
  AddType text/plain .txt
  AddType text/xml .xml .xsl
  AddType application/manifest+json .webmanifest
</IfModule>

# Compress text files. Apache serves .js as text/javascript, so both JavaScript types are listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
