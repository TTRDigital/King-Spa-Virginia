# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read
# at build time (static export). Never commit real values.

# --- Sanity (the site shows its built-in content until the CMS has content)
NEXT_PUBLIC_KSV_SANITY_PROJECT_ID=
NEXT_PUBLIC_KSV_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://virginia.kingspa.com

# --- Tags (the live site's IDs are the defaults). 1 = load no tags (local testing).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_DISABLE_TAGS=
