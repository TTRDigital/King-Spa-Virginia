column elementor-col-100 elementor-top-column elementor-element elementor-element-39765d0e","attrs":{"data-id":"39765d0e","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"19ae6d55","wtype":"text-editor.default","cls":"elementor-element elementor-element-19ae6d55 elementor-widget elementor-widget-text-editor","attrs":{"data-id":"19ae6d55","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<div class=\"sophia-kim-profile\" style=\"background:#f4f9fd;border:1px solid #dbeaf5;border-radius:18px;padding:40px;max-width:860px;margin:0 auto;\">\n<figure class=\"wp-block-image size-medium\" style=\"margin:0 0 24px;\"><img alt=\"Sophia Kim, esthetician and massage therapist at King Spa Virginia\" decoding=\"async\" fetchpriority=\"high\" height=\"400\" src=\"/images/wp/2026/09/sophia-kim-headshot.jpeg\" style=\"border-radius:16px;box-shadow:0 10px 28px rgba(11,62,95,.16);display:block;\" width=\"400\"/></figure>\n<h1 style=\"color:#0b2b3f;margin:0 0 12px;\">Sophia Kim</h1>\n<p style=\"margin:0 0 24px;\"><strong style=\"display:inline-block;background:#0f87c9;color:#ffffff;font-size:15px;letter-spacing:.3px;padding:9px 22px;border-radius:999px;\">Esthetician (2019) · Massage Therapist (2026)</strong></p>\n<p style=\"color:#33475b;line-height:1.75;\">Sophia Kim is an esthetician and massage therapist at King Spa Virginia in Chantilly, Northern Virginia. She earned her esthetician license in 2019 and her massage therapy license in 2026.</p>\n<p style=\"color:#33475b;line-height:1.75;\">Her family has operated in the spa industry since 2012. Sophia has been involved with King Spa Virginia since planning began in 2020, and the Chantilly location opened in 2021. Day to day she focuses on skincare routines, facial treatments and procedures, and helping guests understand the science-based health and wellness benefits of sauna and heat therapy. Guests have also responded well to the spa’s hot salt rock menu, a heat experience similar to hot stone therapy.</p>\n<p style=\"color:#33475b;line-height:1.75;\">Topics she is best suited to cover include skincare and facial care, spa and wellness treatments, sauna therapy, and the science of sauna benefits.</p>\n<h2 style=\"color:#0f87c9;font-size:21px;letter-spacing:.4px;margin:36px 0 14px;\">Connect</h2>\n<a href=\"https://www.linkedin.com/in/sophia-kim-kingspavirginia/\" rel=\"me noopener\" style=\"display:inline-block;background:#0f87c9;color:#ffffff;font-weight:600;text-decoration:none;padding:11px 28px;border-radius:10px;\" target=\"_blank\">LinkedIn</a>\n<h2 style=\"color:#0f87c9;font-size:21px;letter-spacing:.4px;margin:36px 0 14px;\">Topics</h2>\n<p style=\"margin:0;\"><span style=\"display:inline-block;background:#e3f1fa;color:#0b6ea0;font-weight:600;font-size:14px;padding:8px 18px;border-radius:999px;margin:0 8px 8px 0;\">Skincare/facials</span><span style=\"display:inline-block;background:#e3f1fa;color:#0b6ea0;font-weight:600;font-size:14px;padding:8px 18px;border-radius:999px;margin:0 8px 8px 0;\">spa treatments</span><span style=\"display:inline-block;backgrounxd:#e3f1fa;clor:#0b6ea0;font-weight:600;font-size:14px;padding:8px 18px;border-radius:999px;margin:0 8px 8px 0;\">sauna/heat therapy</span></p>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-default"}]}],"nav":{"menu-item-17793":{"cls":"current-page-ancestor","ariaCurrent":null}}}