umn-gap-default"},{"_type":"section","_key":"dd1f6ae","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-dd1f6ae elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"dd1f6ae","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"6addc71","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-6addc71","attrs":{"data-id":"6addc71","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"3227c6f","wtype":"text-editor.default","cls":"elementor-element elementor-element-3227c6f elementor-widget elementor-widget-text-editor","attrs":{"data-id":"3227c6f","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<p>At King Spa, we like to think of ourselves as the perfect all-day spa destination where people come to relax, unwind, and rejuvenate in a luxurious, authentic Korean Spa. And we pride ourselves in putting our guest’s happiness at the heart of everything we do here. That’s why we’re always more than happy to answer any questions or concerns you might have about any of our services, facilities, rules and regulations, and more.</p><p>If you have questions about any of our <a href=\"/treatments/\"><span style=\"font-weight: 400;\">Korean spa services</span></a><span style=\"font-weight: 400;\"> or anything else, check out our </span><a href=\"/about/faq/\"><span style=\"font-weight: 400;\">FAQ</span></a><span style=\"font-weight: 400;\"> page. If you’re looking for pricing information, you can check out our </span><a href=\"/price/\"><span style=\"font-weight: 400;\">treatment prices</span></a><span style=\"font-weight: 400;\">. If you can’t find answers to your questions on any of those pages, you can contact us by calling us, emailing us, or stopping by our location in Chantilly, VA. Our friendly staffs are always standing by to lend help.</span></p><p>For even more from King Spa, sign up for our weekly <a href=\"/\"><span style=\"font-weight: 400;\">newsletter</span></a><span style=\"font-weight: 400;\"> to stay up to date with everything happening around the spa, including special deals, contests, promotions, updates, upcoming events, and so much more!</span></p><p>And don’t forget to follow us on our social media channels where we offer even more!</p><p>We hope to see you at King Spa soon.</p>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-default"},{"_type":"section","_key":"d75db29","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-d75db29 elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"d75db29","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"f8ab94c","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-f8ab94c","attrs":{"data-id":"f8ab94c","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"8eb69ea","wtype":"google_maps.default","cls":"elementor-element elementor-element-8eb69ea elementor-widget elementor-widget-google_maps","attrs":{"data-id":"8eb69ea","data-element_type":"widget","data-e-type":"widget","data-widget_type":"google_maps.default"},"html":"<div class=\"elementor-custom-embed\">\n<iframe aria-label=\"25330 Eastern Marketplace Plaza, Chantilly, VA 20152\" loading=\"lazy\" src=\"https://maps.google.com/maps?q=25330%20Eastern%20Marketplace%20Plaza%2C%20Chantilly%2C%20VA%2020152&amp;t=m&amp;z=15&amp;output=embed&amp;iwloc=near\" title=\"25330 Eastern Marketplace Plaza, Chantilly, VA 20152\"></iframe>\n</div>"}],"wrapCls":"el