g","attrs":{"data-id":"3643853","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"What Makes King Spa Unique?"}},{"_type":"widget","_key":"066370b","wtype":"text-editor.default","cls":"elementor-element elementor-element-066370b elementor-widget elementor-widget-text-editor","attrs":{"data-id":"066370b","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"We’re the only spa in the U.S. using patented technology for our Bul-Ga-Ma sauna that uses real wood for heating. Our founder, Byung, developed this special technology to allow visitors to this room to have a truly one-of-a-kind experience. We also boast the hottest sauna in the world – our Bul-Han-Jing-Mak sauna which is the only spa in the U.S. to use real oakwood in our heating process. And all of our saunas use radiant heat, not electricity, like other spas. This enhances the healing process of the saunas and allows you to have the most authentic experience as you relax."},{"_type":"widget","_key":"d4586c9","wtype":"button.default","cls":"elementor-element elementor-element-d4586c9 elementor-align-center elementor-widget elementor-widget-button","attrs":{"data-id":"d4586c9","data-element_type":"widget","data-e-type":"widget","data-widget_type":"button.default"},"html":"<div class=\"elementor-button-wrapper\">\n<a class=\"elementor-button elementor-button-link elementor-size-lg\" href=\"/day-pass/\">\n<span class=\"elementor-button-content-wrapper\">\n<span class=\"elementor-button-text\">Purchase your Day Pass</span>\n</span>\n</a>\n</div>"},{"_type":"widget","_key":"eade3ce","wtype":"text-editor.default","cls":"elementor-element elementor-element-eade3ce elementor-widget elementor-widget-text-editor","attrs":{"data-id":"eade3ce","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<p>If you have questions that aren’t answered on our <a href=\"/about/faq/\">FAQ</a> page, feel free to <a href=\"/contact-us/\">Contact Us</a> and we’d be more than happy to help you.</p>"},{"_type":"widget","_key":"573d896","wtype":"button.default","cls":"elementor-element elementor-element-573d896 elementor-align-center elementor-widget elementor-widget-button","attrs":{"data-id":"573d896","data-element_type":"widget","data-e-type":"widget","data-widget_type":"button.default"},"html":"<div class=\"elementor-button-wrapper\">\n<a class=\"elementor-button elementor-button-link elementor-size-lg\" href=\"/contact-us/\">\n<span class=\"elementor-button-content-wrapper\">\n<span class=\"elementor-button-text\">Contact Us</span>\n</span>\n</a>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-default"},{"_type":"section","_key":"c32cf84","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-c32cf84 elementor-section-full_width elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"c32cf84","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"b84eeda","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-b84eeda","attrs":{"data-id":"b84eeda","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"665f7e3","wtype":"image.default","cls":"elementor-element elementor-element-665f7e3 elementor-absolute elementor-widget elementor-widget-image","attrs":{"data-id":"665f7e3","data-element_type":"widget","data-e-type":"widget","data-settings":"{\"_position\":\"absolute\"}","data-widget_type":"image.default"},"image":{"img":{"loading":"lazy","decoding":"async","width":"295","height":"397","src":"/images/wp/2021/08/left-graphic.png","class":"attachment-full size-full wp-image-113","alt":"Stylish left-side graphic at King Spa","sizes":"(max-width: 295px) 100vw, 295px"},"link":null}},{"_type":"widget","_key":"5e460b0","wtype":"image.default","cls":"elementor-element elementor-element-5e460b0 elementor-absolute elementor-widget elementor-widget-image","attrs":{"data-id":"5e460b0","data-element_type":"widget","data-e-type":"widget","data-settings":"{\"_position\":\"absolute\"}","data-widget_type":"image.default"},"image":{"img":{"loading":"lazy","decoding":"async","width":"280","height":"397","src":"/images/wp/2021/08/right-graphic.png","class":"attachment-full size-full wp-image-114","alt":"Stylish right-side graphic at King Spa","sizes":"(max-width: 280px) 100vw, 280px"},"link":null}},{"_type":"section","_key":"c14b01f","tag":"section","cls":"elementor-section elementor-inner-section elementor-element elementor-element-c14b01f elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"c14b01f","data-element_type":"section","data-e-type":"section"},"columns":[{"_type":"column","_key":"124e6b1","cls":"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-124e6b1","attrs":{"data-id":"124e6b1","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"5535d30","wtype":"heading.default","cls":"elementor-element elementor-element-5535d30 elementor-widget elementor-widget-heading","attrs":{"data-id":"5535d30","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"Faq"}},{"_type":"widget","_key":"7a72f07","wtype":"divider.default","cls":"elementor-element elementor-element-7a72f07 elementor-widget-divider--view-line elementor-widget elementor-widget-divider","attrs":{"data-id":"7a72f07","data-element_type":"widget","data-e-type":"widget","data-widget_type":"divider.default"},"html":"<div class=\"elementor-divider\">\n<span class=\"elementor-divider-separator\">\n</span>\n</div>"},{"_type":"widget","_key":"f0fb63b","wtype":"accordion.default","cls":"elementor-element elementor-element-f0fb63b faq-wrapper elementor-widget elementor-widget-accordion","attrs":{"data-id":"f0fb63b","data-element_type":"widget","data-e-type":"widget","data-widget_type":"accordion.default"},"html":"<div class=\"elementor-accordion\">\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-2521\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"1\" id=\"elementor-tab-title-2521\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">What does my day pass include? </a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-2521\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"1\" id=\"elementor-tab-content-2521\" role=\"region\"><p><strong>Your daily admission pass includes access to: </strong></p><ul><li>Locker Room &amp; Steam Rooms</li><li>Saunas &amp; Base Rock Room</li><li>Outdoor &amp; Indoor Bade Pools</li><li>Jacuzzis &amp; Cold Plunge Pool</li><li>Media Room &amp; Indoor Lounges</li></ul><p><strong>Your pass also includes:</strong></p><ul><li>Spa uniforms (all sizes available. Must be worn during your visit)</li><li>Complimentary toiletries</li><li>Towels</li><li>Shampoo/conditioner/soap</li></ul><p><strong>Please Note:</strong></p><ul><li>Remember to bring your bathing suit if you plan to visit our outdoor or indoor bade pools (you cannot enter these pools without appropriate swimwear).</li><li>Spa treatments, products, food &amp; beverages are available for an additional fee</li><li>You cannot leave our facility once you have entered. Please remember to bring all your belongings with you BEFORE entering the spa.</li></ul></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-2522\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"2\" id=\"elementor-tab-title-2522\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">What do I need to bring for my spa day at King Spa Virginia? </a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-2522\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"2\" id=\"elementor-tab-content-2522\" role=\"region\"><ul><li>Valid government issued photo ID (pictures of ID’s and foreign driver’s licenses will not be accepted)</li><li>Swimsuit (Cotton &amp; denim swimwear are not allowed in the water)</li><li>(Swimsuits are available for purchase in the Locker Rooms.)</li><li>Spa lounge uniforms &amp; towels are provided during your stay at King Spa Virginia. </li></ul></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-2523\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"3\" id=\"elementor-tab-title-2523\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Do I need a reservation to visit King Spa Virginia? </a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-2523\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"3\" id=\"elementor-tab-content-2523\" role=\"region\"><p>No, we are on a first come first serve basis at the moment. </p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-2524\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"4\" id=\"elementor-tab-title-2524\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">What is the price of admission? </a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-2524\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"4\" id=\"elementor-tab-content-2524\" role=\"region\"><p>To see our current admission fees, please click on “Buy Day Pass.” Prices are subject to change. Please note that some holidays that fall on a weekday will require a weekend rate. To see which holidays require the weekend rate, please see the list of holidays in the following question. Admission does not include treatments, products, food and beverages.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-2525\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"5\" id=\"elementor-tab-title-2525\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Are children allowed at King Spa Virginia? </a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-2525\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"5\" id=\"elementor-tab-content-2525\" role=\"region\"><p>Children under the age of 12 are not permitted under any circumstances. Minors under 17 years old must be accompanied by an adult 21+ years old and of the same gender. A maximum of 3 children per adult of the same gender are permitted.</p><p>(Minors will need a school ID or copy of birth certificate)</p></div>\n</div>\n</div>"},{"_type":"widget","_key":"8240cfc","wtype":"button.default","cls":"elementor-element elementor-element-8240cfc elementor-align-center elementor-widget elementor-widget-button","attrs":{"data-id":"8240cfc","data-element_type":"widget","data-e-type":"widget","data-widget_type":"button.default"},"html":"<div class=\"elementor-button-wrapper\">\n<a class=\"elementor-button elementor-button-link elementor-size-lg\" href=\"/about/faq/\">\n<span class=\"elementor-button-content-wrapper\">\n<span class=\"elementor-button-text\">Explore more faqs</span>\n</span>\n</a>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-default"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-default"},{"_type":"section","_key":"b6e2a3c","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-b6e2a3c testimonial-wrapper elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"b6e2a3c","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"2064c3d","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-2064c3d","attrs":{"data-id":"2064c3d","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"section","_key":"c69942a","tag":"section","cls":"el