 max-width: 32em; }\n.ksph-hero-photo { flex: 1 1 48%; min-width: 0; }\n.ksph-hero-photo img { border-radius: 18px; display: block; width: 100%; box-shadow: 0 30px 70px rgba(0,0,0,.4); border: 1px solid rgba(242,198,109,.25); }\n/* ---------- DIVIDER ---------- */\n.ksph-divider { display: flex; align-items: center; gap: 16px; max-width: 560px; margin: 0 auto; padding: 52px 24px; }\n.ksph-divider::before, .ksph-divider::after { content: \"\"; height: 1px; flex: 1; background: linear-gradient(90deg, transparent, #C0782A, transparent); }\n.ksph-divider span { font-size: 1.3rem; line-height: 1; }\n/* ---------- OFFERS (full bleed) ---------- */\n.ksph-offers { background: #FAF3E6; }\n.ksph-offers-inner { padding-top: clamp(60px, 6vw, 92px); padding-bottom: clamp(60px, 6vw, 92px); }\n.ksph-label { text-align: center; color: #A6492B; letter-spacing: .32em; text-indent: .32em; font-size: .82rem; font-weight: 700; text-transform: uppercase; margin: 0 0 36px; }\n.ksph-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }\n.ksph-card { background: #ffffff; border-radius: 20px; border-top: 5px solid #C0782A; box-shadow: 0 20px 48px rgba(11,34,57,.10); padding: clamp(36px, 3vw, 52px); }\n.ksph-card h2 { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; color: #0B2239; font-size: 2.2rem; font-weight: 700; line-height: 1.2; margin: 0 0 14px; }\n.ksph-pill { display: inline-block; background: #0B2239; color: #ffffff; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; padding: 10px 22px; border-radius: 999px; margin: 0 0 26px; }\n.ksph-price { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; color: #B4532A; font-size: 4.4rem; font-weight: 700; line-height: 1; margin: 0; }\n.ksph-price-cap { color: #0B2239; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; font-size: .82rem; margin: 12px 0 6px; }\n.ksph-was { color: #5b6b7d; font-size: 1.05rem; margin: 0; }\n.ksph-badge { display: inline-block; background: #A6492B; color: #ffffff; font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 7px 18px; border-radius: 999px; margin-top: 12px; }\n.ksph-facts { list-style: none; margin: 26px 0 0; padding: 0; }\n.ksph-facts li { position: relative; padding: 11px 0 11px 32px; color: #33465c; font-size: 1.06rem; line-height: 1.5; border-top: 1px solid #F0E4CE; }\n.ksph-facts li:first-child { border-top: 0; }\n.ksph-facts li::before { content: \"\\2726\"; color: #C0782A; position: absolute; left: 2px; top: 12px; font-size: .95rem; }\n.ksph-card-hr { border: 0; border-top: 1px solid #F0E4CE; margin: 28px 0; padding: 0; }\n.ksph-expire { font-size: 1.35rem; font-weight: 800; color: #0B2239; background: #FBEEDC; border-left: 4px solid #C0782A; padding: 14px 18px; border-radius: 0 12px 12px 0; margin: 18px 0 0; }\n.ksph-detail { color: #33465c; font-size: 1.06rem; line-height: 1.6; margin: 12px 0 0; }\n.ksph-note { text-align: center; color: #5b6b7d; font-size: 1rem; line-height: 1.6; margin: 26px 0 0; }\n.ksph-card-photo { margin: 28px 0 0; padding: 0; }\n.ksph-card-photo img { border-radius: 14px; display: block; width: 100%; aspect-ratio: 16/10; object-fit: cover; box-shadow: 0 16px 36px rgba(11,34,57,.14); }\n/* ---------- PHOTO STRIP (full bleed) ---------- */\n.ksph-strip { background: #FFFDF8; }\n.ksph-strip-inner { padding-top: clamp(8px, 2vw, 20px); padding-bottom: clamp(60px, 6vw, 88px); }\n.ksph-strip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n.ksph-strip-grid img { border-radius: 16px; display: block; width: 100%; height: 100%; aspect-ratio: 4/3; object-fit: cover; box-shadow: 0 18px 40px rgba(11,34,57,.12); }\n/* ---------- GOOD TO KNOW ---------- */\n.ksph-gtk-inner { max-width: 1100px; margin: 0 auto; padding: 12px 32px 8px; text-align: center; }\n.ksph-gtk h2 { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; color: #0B2239; font-size: clamp(2rem, 3.4vw, 2.8rem); font-weight: 700; margin: 0 0 20px; }\n.ksph-gtk .ksph-goldrule { margin: 0 auto 32px; }\n.ksph-check { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 40px; text-align: left; }\n.ksph-check li { position: relative; padding-left: 38px; color: #33465c; font-size: 1.06rem; line-height: 1.55; }\n.ksph-check li::before { content: \"\\2726\"; color: #C0782A; position: absolute; left: 0; top: 1px; font-size: 1.05rem; }\n/* ---------- CLOSING (full bleed) ---------- */\n.ksph-close { background: radial-gradient(1000px 480px at 50% 0%, rgba(232,169,61,.12), transparent 60%), #0B2239; margin-top: 64px; }\n.ksph-close-inner { text-align: center; padding-top: clamp(64px, 6vw, 96px); padding-bottom: clamp(64px, 6vw, 96px); }\n.ksph-close-photo { display: block; max-width: 880px; width: 100%; margin: 0 auto 40px; border-radius: 18px; aspect-ratio: 21/9; object-fit: cover; box-shadow: 0 30px 70px rgba(0,0,0,.4); border: 1px solid rgba(242,198,109,.22); }\n.ksph-close h2 { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; color: #ffffff; font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 700; margin: 0 0 16px; }\n.ksph-close p.ksph-close-sub { color: #EDE3D3; margin: 0 0 32px; font-size: 1.12rem; }\n.ksph-btn { display: inline-block; background: linear-gradient(135deg, #D98E32, #E8A93D); color: #0B2239 !important; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; font-size: .95rem; padding: 18px 52px; border-radius: 999px; text-decoration: none; box-shadow: 0 14px 30px rgba(217,142,50,.35); transition: transform .2s ease, box-shadow .2s ease; }\n.ksph-btn:hover { background: linear-gradient(135deg, #E8A93D, #F2C66D); color: #0B2239 !important; transform: translateY(-2px); box-shadow: 0 18px 36px rgba(217,142,50,.45); }\n.ksph-contact { margin: 34px 0 0; color: #9FB0C3; font-size: 1.02rem; line-height: 1.9; }\n.ksph-contact a { color: #F2C66D; text-decoration: none; }\n.ksph-contact a:hover { text-decoration: underline; }\n/* ---------- RESPONSIVE ---------- */\n@media (max-width: 960px) {\n.ksph-hero-inner { flex-direction: column; align-items: stretch; }\n.ksph-cards { grid-template-columns: 1fr; }\n.ksph-check { grid-template-columns: 1fr; }\n.ksph-strip-grid { grid-template-columns: 1fr; }\n}\n</style></p>\n<div class=\"ksph\">\n<section class=\"ksph-hero\">\n<div class=\"ksph-wrap ksph-hero-inner\">\n<div class=\"ksph-hero-text\">\n<p class=\"ksph-kicker\">✦ Limited-Time Promotions ✦</p>\n<h1>Fall Promotions</h1>\n<hr class=\"ksph-goldrule\"/>\n<p class=\"ksph-intro\">Sweater weather is here. This fall at King Spa Virginia in Chantilly: our Fall Weekday Special, plus a limited 10-pack sale. </p>\n</div>\n<div class=\"ksph-hero-photo\"><img alt=\"King Spa Virginia logo\" class=\"alignnone size-full wp-image-18821\" decoding=\"async\" height=\"118\" src=\"/images/wp/2025/04/king-spa-logo.svg\" width=\"123\"/></div>\n</div>\n</section>\n<section class=\"ksph-offers\">\n<div class=\"ksph-wrap ksph-offers-inner\">\n<p class=\"ksph-label\">✦ Two Limited-Time Offers ✦</p>\n<div class=\"ksph-cards\">\n<article class=\"ksph-card\">\n<h2>Fall Weekday Special</h2>\n<span class=\"ksph-pill\">October 27 – November 25, 2026</span>\n<p class=\"ksph-price\">$35</p>\n<p class=\"ksph-price-cap\">Admission</p>\n<p class=\"ksph-was\">Regularly $80</p>\n<span class=\"ksph-badge\">Over 55% Off</span>\n<ul class=\"ksph-facts\">\n<li>Tuesdays, Wednesdays &amp; Thursdays Only</li>\n<li>In-Store Purchase Only</li>\n<li>Cannot Be Used on Holidays</li>\n</ul>\n<figure class=\"ksph-card-photo\"></figure>\n</article>\n<article class=\"ksph-card\">\n<h2>10-Pack Sale</h2>\n<p class=\"ksph-price\">$400</p>\n<p class=\"ksph-detail\">$400 for a 10-pack of admission passes.</p>\n<p class=\"ksph-detail\">Can be used any day, including holidays.</p>\n<p class=\"ksph-expire\">Passes expire 6 months after purchase and cannot be used after the expiration date.</p>\n<p class=\"ksph-note\"><span style=\"font-size: 16px;\">Sale ends November 14.</span></p>\n</article>\n</div>\n</div>\n</section>\n<section class=\"ksph-strip\">\n<div class=\"ksph-wrap ksph-strip-inner\">\n<div class=\"ksph-strip-grid\"><img alt=\"Indoor bathhouse pools at King Spa Virginia\" decoding=\"async\" src=\"/images/wp/2025/07/korean-bathhouse-pool.webp\"/> <img alt=\"Aqua pool with waterfall at King Spa Virginia\" decoding=\"async\" src=\"/images/wp/2025/07/Aqua-Pool.webp\"/><img alt=\"Outdoor pool at King Spa Virginia\" class=\"alignnone size-full wp-image-2026\" decoding=\"async\" fetchpriority=\"high\" height=\"1280\" sizes=\"(max-width: 1920px) 100vw, 1920px\" src=\"/images/wp/2021/10/Outdoor-Pool-scaled.jpg\" width=\"1920\"/></div>\n</div>\n</section>\n<div aria-hidden=\"true\" class=\"ksph-divider\"> </div>\n<section class=\"ksph-gtk\">\n<div class=\"ksph-gtk-inner\">\n<h2>Good to Know</h2>\n<hr class=\"ksph-goldrule\"/>\n<ul class=\"ksph-check\">\n<li>Cannot be combined with other promotions or offers.</li>\n<li>No refunds and no rain checks. The 20-minute grace period does not apply.</li>\n<li>Cannot be applied to future visits.</li>\n<li>Children under 12 are not permitted. Guests ages 12-17 must be accompanied at all times by a parent.</li>\n<li>3 minors to 1 adult ratio per gender. The adult must be 25+ and present at all times.</li>\n<li>Price is for a day pass. Treatments, food and products are additional cost.</li>\n</ul>\n</div>\n</section>\n<section class=\"ksph-close\">\n<div class=\"ksph-wrap ksph-close-inner\"><img alt=\"Outdoor bade pool at King Spa Virginia\" class=\"ksph-close-photo\" decoding=\"async\" src=\"/images/wp/2025/05/king-spa-outdoor-bath-pool.jpg\"/>\n<h2>Plan Your Visit</h2>\n<p class=\"ksph-close-sub\">Give the gift of relaxation, or treat yourself this fall.</p>\n<a class=\"ksph-btn\" href=\"/\">Plan Your Visit</a>\n<p class=\"ksph-contact\">25330 Eastern Marketplace Plaza, Chantilly, VA<br/><a href=\"tel:+17039573010\">(703) 957-3010</a></p>\n</div>\n</section>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-default"}]}],"nav":{}}