mentor-widget-image-carousel","attrs":{"data-id":"fdbdcbb","data-element_type":"widget","data-e-type":"widget","data-settings":"{\"slides_to_show\":\"1\",\"navigation\":\"both\",\"autoplay\":\"yes\",\"pause_on_hover\":\"yes\",\"pause_on_interaction\":\"yes\",\"autoplay_speed\":5000,\"infinite\":\"yes\",\"effect\":\"slide\",\"speed\":500}","data-widget_type":"image-carousel.default"},"html":"<div aria-label=\"Image Carousel\" aria-roledescription=\"carousel\" class=\"elementor-image-carousel-wrapper swiper\" dir=\"ltr\" role=\"region\">\n<div aria-live=\"off\" class=\"elementor-image-carousel swiper-wrapper\">\n<div aria-label=\"1 of 1\" aria-roledescription=\"slide\" class=\"swiper-slide\" role=\"group\"><figure class=\"swiper-slide-inner\"><img alt=\"bubble-bath-image-opt\" class=\"swiper-slide-image\" decoding=\"async\" src=\"/images/wp/2025/07/bubble-bath-image-opt.webp\"/></figure></div> </div>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"ca77dd8","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-ca77dd8 elementor-section-content-middle slider-content-wrapper elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"ca77dd8","data-element_type":"section","data-e-type":"section","id":"bul-han-jing-mak","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"b6c3f82","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-b6c3f82 content-wrap","attrs":{"data-id":"b6c3f82","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"532b996","wtype":"heading.default","cls":"elementor-element elementor-element-532b996 elementor-widget elementor-widget-heading","attrs":{"data-id":"532b996","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"What is King Spa's Bubble Body Scrub?"}},{"_type":"widget","_key":"7938e73","wtype":"text-editor.default","cls":"elementor-element elementor-element-7938e73 elementor-widget elementor-widget-text-editor","attrs":{"data-id":"7938e73","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"This 90-minute luxurious spa treatment combines the skin-rejuvenating effects of Turkish baths with the deeply exfoliating benefits of Korean body scrubs. This treatment can be performed on individuals in the women’s spa bathhouse or on couples/pairs in a private, designated room."},{"_type":"widget","_key":"3d6ae18","wtype":"text-editor.default","cls":"elementor-element elementor-element-3d6ae18 elementor-widget elementor-widget-text-editor","attrs":{"data-id":"3d6ae18","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<h3>Step 1: Turkish Bubble Bath</h3><p>The Turkish bath is a luxurious and soothing experience that begins with warm water immersion. This relaxing bath envelops you in a sea of delicate bubbles, created from high-quality soap lather. The bubbles provide a gentle and calming sensation, preparing your body and mind for the next phase of the treatment. This part of the process not only relaxes your muscles but also opens up your pores, making your skin more receptive to the exfoliation that follows.</p><h3>Step 2: Korean Body Scrub</h3><p>Traditional Korean body scrubs use specialized scrubbing mitts to remove dead skin cells and impurities from your body. Our skilled therapists apply firm and precise movements to effectively cleanse your skin, revealing a smoother and more radiant complexion. The Korean body scrub not only enhances your skin’s texture but also stimulates blood circulation, leaving you feeling invigorated and refreshed.</p>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"3008a93","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-3008a93 elementor-section-content-middle slider-content-wrapper elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"3008a93","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"f148769","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-f148769 content-wrap","attrs":{"data-id":"f148769","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"c987da1","wtype":"heading.default","cls":"elementor-element elementor-element-c987da1 elementor-widget elementor-widget-heading","attrs":{"data-id":"c987da1","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"The Treatment Process"}},{"_type":"widget","_key":"a92f6b2","wtype":"text-editor.default","cls":"elementor-element elementor-element-a92f6b2 other-massage elementor-widget elementor-widget-text-editor","attrs":{"data-id":"a92f6b2","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<h3>1. Warm Water Immersion</h3><p>The treatment begins with immersing your body in warm water, which helps to relax your muscles and open up your pores. This prepares your skin for the cleansing and exfoliation process.</p><h3>2. Bubble Immersion</h3><p>High-quality soap lather is then applied to create a sea of delicate, soothing bubbles. These bubbles envelop your body, providing a calming and luxurious sensation.</p><h3>3. Thorough Body Scrubbing</h3><p>Next, our skilled therapists perform the Korean body scrub exfoliation treatment using specialized scrubbing mitts. They apply firm, precise movements to exfoliate your skin, removing dead skin cells and impurities. This step ensures a deep cleanse and revitalizes your skin’s texture.</p><h3>4. Rinsing and Hydration</h3><p>After the scrubbing process, your body is thoroughly rinsed to remove any remaining soap and exfoliated skin. Finally, a hydrating treatment is applied to nourish and moisturize your freshly exfoliated skin, leaving it soft, smooth, and glowing.</p>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"f544e99","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-f544e99 elementor-section-content-middle slider-content-wrapper elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"f544e99","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"86b6c1c","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-86b6c1c content-wrap","attrs":{"data-id":"86b6c1c","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"39deac9","wtype":"heading.default","cls":"elementor-element elementor-element-39deac9 elementor-widget elementor-widget-heading","attrs":{"data-id":"39deac9","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"Benefits of Our Bubble Body Scrub"}},{"_type":"widget","_key":"21fefb3","wtype":"text-editor.default","cls":"elementor-element elementor-element-21fefb3 elementor-widget elementor-widget-text-editor","attrs":{"data-id":"21fefb3","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<h3>Deep Cleanse &amp; Exfoliation</h3><p>The combined effects of the Turkish bubble bath and Korean body scrub provide a thorough cleansing and exfoliation of your skin. This process removes dead skin cells, unclogs pores, and eliminates impurities, leaving your skin feeling exceptionally clean and smooth.</p><h3>Improved Skin Texture &amp; Softness</h3><p>Regular exfoliation from the Korean body scrub enhances your skin’s texture, making it softer and more radiant. The Turkish bubble bath helps to hydrate and nourish your skin, contributing to a healthy glow.</p><h3>Relaxation &amp; Stress Relief</h3><p>The warm, soothing bubbles of the Turkish bath and the gentle yet effective scrubbing techniques create a deeply relaxing experience. This treatment helps to reduce stress and tension, promoting overall well-being.</p><h3>Enhanced Blood Circulation</h3><p>The Korean body scrub stimulates blood circulation, which can improve the delivery of nutrients to your skin and promote a healthy, vibrant appearance. Enhanced circulation also aids in detoxification, helping your body to eliminate toxins more efficiently.</p>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"91258c2","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-91258c2 elementor-section-content-middle slider-content-wrapper elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"91258c2","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"0f69570","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-0f69570 content-wrap","attrs":{"data-id":"0f69570","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"24a75f7","wtype":"heading.default","cls":"elementor-element elementor-element-24a75f7 elementor-widget elementor-widget-heading","attrs":{"data-id":"24a75f7","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"Booking Your Treatment"}},{"_type":"widget","_key":"1f2fea6","wtype":"text-editor.default","cls":"elementor-element elementor-element-1f2fea6 elementor-widget elementor-widget-text-editor","attrs":{"data-id":"1f2fea6","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"Ready to experience the rejuvenating effects of King Spa’s Bubble Body Scrub treatment? Visit us in-person at our second-floor kiosk (for couples) or the women’s locker room (for solo) and our friendly staff will help you schedule your appointment. This is a popular treatment, so try to arrive early to ensure you secure a slot!"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"4c4d61b","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-4c4d61b elementor-section-content-middle slider-content-wrapper elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"4c4d61b","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"0a2ce42","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-0a2ce42 content-wrap","attrs":{"data-id":"0a2ce42","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"8461018","wtype":"heading.default","cls":"elementor-element elementor-element-8461018 elementor-widget elementor-widget-heading","attrs":{"data-id":"8461018","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"Frequently Asked Questions (FAQ)"}},{"_type":"widget","_key":"9ccf531","wtype":"accordion.default","cls":"elementor-element elementor-element-9ccf531 elementor-widget elementor-widget-accordion","attrs":{"data-id":"9ccf531","data-element_type":"widget","data-e-type":"widget","data-widget_type":"accordion.default"},"html":"<div class=\"elementor-accordion\">\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1641\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"1\" id=\"elementor-tab-title-1641\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">What should I expect during the Bubble Body Scrub treatment?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1641\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"1\" id=\"elementor-tab-content-1641\" role=\"region\"><p>This spa treatment begins with a warm Turkish bubble bath to relax your muscles and open your pores, followed by a thorough Korean body scrub to exfoliate and revitalize your skin.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1642\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"2\" id=\"elementor-tab-title-1642\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Who can receive this treatment?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1642\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"2\" id=\"elementor-tab-content-1642\" role=\"region\"><p>This treatment is made for couples/pairs and also individuals in the women’s private bathhouse.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1643\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"3\" id=\"elementor-tab-title-1643\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Is the Korean body scrub suitable for sensitive skin?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1643\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"3\" id=\"elementor-tab-content-1643\" role=\"region\"><p>No, A Korean body scrub isn’t ideal for all skin types. If your skin is sensitive, you should avoid the treatment unless approved by your therapist.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1644\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"4\" id=\"elementor-tab-title-1644\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">How long does the treatment take?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1644\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"4\" id=\"elementor-tab-content-1644\" role=\"region\"><p>The entire Bubble Body Scrub treatment typically lasts about 90 minutes, providing ample time for relaxation and rejuvenation.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1645\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"5\" id=\"elementor-tab-title-1645\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Do I need to bring anything for the treatment?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1645\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"5\" id=\"elementor-tab-content-1645\" role=\"region\"><p>You don’t need to bring anything specific. We provide all necessary materials, including towels, robes, and high-quality scrubbing mitts.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1646\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"6\" id=\"elementor-tab-title-1646\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">How often should I get a Bubble Body Scrub treatment?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1646\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"6\" id=\"elementor-tab-content-1646\" role=\"region\"><p>For optimal results, we recommend getting a Bubble Body Scrub treatment once a month. However, the frequency can vary based on your skin type and personal preference.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1647\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"7\" id=\"elementor-tab-title-1647\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Are there any pre-treatment or post-treatment care instructions?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1647\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"7\" id=\"elementor-tab-content-1647\" role=\"region\"><ul><li><strong>Pre-treatment:</strong> Ensure you are well-hydrated and avoid heavy meals before your treatment.</li><li><strong>Post-treatment:</strong> After the treatment, keep your skin moisturized and avoid direct sun exposure for at least 24 hours to maintain the benefits.</li></ul></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1648\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"8\" id=\"elementor-tab-title-1648\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Can I combine the Bubble Body Scrub with other services at King Spa?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1648\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"8\" id=\"elementor-tab-content-1648\" role=\"region\"><p>Absolutely! We offer a variety of spa treatments that can enhance your experience. Feel free to explore our other spa treatment offerings, such as massage, facial, and v-steam.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-1649\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"9\" id=\"elementor-tab-title-1649\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">How do I get a scheduled appointment for this service?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-1649\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"9\" id=\"elementor-tab-content-1649\" role=\"region\"><p>Appointments can be made by visiting us in-person at our second-floor kiosk (for couples). Women seeking a solo treatment can book inside the women’s locker room. We recommend booking your appointment early to ensure a time slot.</p></div>\n</div>\n<div class=\"elementor-accordion-item\">\n<div aria-controls=\"elementor-tab-content-16410\" aria-expanded=\"false\" class=\"elementor-tab-title\" data-tab=\"10\" id=\"elementor-tab-title-16410\" role=\"button\">\n<span aria-hidden=\"true\" class=\"elementor-accordion-icon elementor-accordion-icon-right\">\n<span class=\"elementor-accordion-icon-closed\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-plus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n<span class=\"elementor-accordion-icon-opened\"><svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-minus\" viewbox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z\"></path></svg></span>\n</span>\n<a class=\"elementor-accordion-title\" tabindex=\"0\">Do you wash hair during a Korean Body Scrub?</a>\n</div>\n<div aria-labelledby=\"elementor-tab-title-16410\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"10\" id=\"elementor-tab-content-16410\" role=\"region\"><p>Yes, hair washing is included as part of the Korean body scrub treatment.</p></div>\n</div>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"f0f5812","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-f0f5812 elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"f0f5812","data-element_type":"section","data-e-type":"section"},"columns":[{"_type":"column","_key":"5b1e38e","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-5b1e38e","attrs":{"data-id":"5b1e38e","data-element_type":"column","data-e-type":"column"},"children":[],"wrapCls":"elementor-widget-wrap"}],"containerCls":"elementor-container elementor-column-gap-default"}]}],"nav":{"menu-item-17754":{"cls":"current-page-ancestor current-menu-ancestor current_page_ancestor","ariaCurrent":null},"menu-item-17776":{"cls":"current-page-ancestor current-menu-ancestor current-menu-parent current-page-parent current_page_parent current_page_ancestor","ariaCurrent":null},"menu-item-17778":{"cls":"current-menu-item current_page_item","ariaCurrent":null},"menu-item-18128":{"cls":"current-menu-ancestor current-menu-parent current_page_parent current_page_ancestor","ariaCurrent":null},"menu-item-17791":{"cls":"current-menu-item current_page_item","ariaCurrent":null}}}