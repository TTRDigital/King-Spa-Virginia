,"data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"a9f2d74","wtype":"image-carousel.default","cls":"elementor-element elementor-element-a9f2d74 elementor-pagination-position-inside elementor-arrows-position-inside elementor-widget elementor-widget-image-carousel","attrs":{"data-id":"a9f2d74","data-element_type":"widget","data-e-type":"widget","data-settings":"{\"slides_to_show\":\"1\",\"navigation\":\"both\",\"autoplay\":\"yes\",\"pause_on_hover\":\"yes\",\"pause_on_interaction\":\"yes\",\"autoplay_speed\":5000,\"infinite\":\"yes\",\"effect\":\"slide\",\"speed\":500}","data-widget_type":"image-carousel.default"},"html":"<div aria-label=\"Image Carousel\" aria-roledescription=\"carousel\" class=\"elementor-image-carousel-wrapper swiper\" dir=\"ltr\" role=\"region\">\n<div aria-live=\"off\" class=\"elementor-image-carousel swiper-wrapper\">\n<div aria-label=\"1 of 1\" aria-roledescription=\"slide\" class=\"swiper-slide\" role=\"group\"><figure class=\"swiper-slide-inner\"><img alt=\"korean-bathhouse-pool\" class=\"swiper-slide-image\" decoding=\"async\" src=\"/images/wp/2025/07/korean-bathhouse-pool.webp\"/></figure></div> </div>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"},{"_type":"column","_key":"3105b38","cls":"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-3105b38 content-wrap","attrs":{"data-id":"3105b38","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"532b996","wtype":"heading.default","cls":"elementor-element elementor-element-532b996 elementor-widget elementor-widget-heading","attrs":{"data-id":"532b996","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"Korean Bath House: What to Expect"}},{"_type":"widget","_key":"4a42456","wtype":"text-editor.default","cls":"elementor-element elementor-element-4a42456 elementor-widget elementor-widget-text-editor","attrs":{"data-id":"4a42456","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<p data-pm-slice=\"1 1 []\">New to this? Learn <a href=\"/blog/what-is-a-korean-bath-house/\">what a Korean bath house is</a>. Grab your keys and head over to King Spa Virginia for a relaxed Korean bathhouse retreat.</p>\nWhat can you expect if this is your first time visiting us? Wondering <a href=\"/blog/what-do-you-need-for-a-spa-day/\">what to bring for your spa day</a>? Our guide covers everything you need for a relaxing visit.\n\nAs you walk to our main door, you will be greeted by the friendly people at our front desk. After you pay, you will be given a bracelet to wear that has the keys to your locker. Take note to wear your locker keys at all times, as this is how food/beverage purchases and <a href=\"/treatments/\">spa treatments</a> are made. You will also be given a uniform and clean towels are available at all times.\n\nForget the outside world for a day and get the spa treatment fit for royalty. Our warm floor, clean bathrooms, showers, locker services separated for men and women, and complimentary toiletries add to the whole experience. Private shower rooms are also available.\n\nHere are some of the wonderful treatment rooms and saunas you can experience during your visit:\n<ul>\n<li>Steam Room</li>\n<li>Ice Room</li>\n<li>Dry Sauna Room</li>\n<li>Charcoal Room</li>\n<li>Yellow Mud Room</li>\n<li>Amethyst Crystal Room</li>\n<li>Himalayan Salt Sauna</li>\n<li>Traditional Korean Body Scrub Treatments</li>\n<li>Massages</li>\n<li>Esthetic Facial Treatments</li>\n<li>Traditional Korean</li>\n<li>V-Steam Treatment</li>\n</ul>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"ca77dd8","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-ca77dd8 elementor-section-content-middle slider-content-wrapper elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"ca77dd8","data-element_type":"section","data-e-type":"section","id":"bul-han-jing-mak","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"b6c3f82","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-b6c3f82 content-wrap","attrs":{"data-id":"b6c3f82","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"6e1ad82","wtype":"heading.default","cls":"elementor-element elementor-element-6e1ad82 elementor-widget elementor-widget-heading","attrs":{"data-id":"6e1ad82","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"Hot Tubs"}},{"_type":"widget","_key":"3d6ae18","wtype":"text-editor.default","cls":"elementor-element elementor-element-3d6ae18 elementor-widget elementor-widget-text-editor","attrs":{"data-id":"3d6ae18","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<p data-pm-slice=\"1 1 []\">Dip into our stimulating and relaxing tubs. All your stresses will slowly melt away as you dip your body into our hot, therapeutic waters.</p><p>One thing to remember if you’re going to the bath area in the gender-separate locker rooms – you’ve got to come in naked. You may only bring your towel with you and must shower prior to entering the hot pools.</p>"},{"_type":"widget","_key":"8c0ce03","wtype":"image.default","cls":"elementor-element elementor-element-8c0ce03 elementor-widget elementor-widget-image","attrs":{"data-id":"8c0ce03","data-element_type":"widget","data-e-type":"widget","data-widget_type":"image.default"},"image":{"img":{"loading":"lazy","decoding":"async","width":"768","height":"512","src":"/images/wp/2023/03/itinerary.jpeg","class":"attachment-medium_large size-medium_large wp-image-12532","alt":"Girl in Hinoki Bath","sizes":"(max-width: 768px) 100vw, 768px"},"link":null}}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"},{"_type":"section","_key":"b1cc79b","tag":"section","cls":"elementor-section elementor-top-section elementor-element elementor-element-b1cc79b elementor-section-content-middle slider-content-wrapper elementor-section-boxed elementor-section-height-default elementor-section-height-default","attrs":{"data-id":"b1cc79b","data-element_type":"section","data-e-type":"section","data-settings":"{\"background_background\":\"classic\"}"},"columns":[{"_type":"column","_key":"fc63b7a","cls":"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-fc63b7a content-wrap","attrs":{"data-id":"fc63b7a","data-element_type":"column","data-e-type":"column"},"children":[{"_type":"widget","_key":"97d157b","wtype":"heading.default","cls":"elementor-element elementor-element-97d157b elementor-widget elementor-widget-heading","attrs":{"data-id":"97d157b","data-element_type":"widget","data-e-type":"widget","data-widget_type":"heading.default"},"heading":{"tag":"h2","cls":"elementor-heading-title elementor-size-default","attrs":{},"html":"Who We Are"}},{"_type":"widget","_key":"33ac08b","wtype":"text-editor.default","cls":"elementor-element elementor-element-33ac08b elementor-widget elementor-widget-text-editor","attrs":{"data-id":"33ac08b","data-element_type":"widget","data-e-type":"widget","data-widget_type":"text-editor.default"},"text":"<p data-pm-slice=\"1 1 []\">Family-owned and operated in Chantilly, VA, we are proud to provide the Northern Virginia, DC, &amp; Maryland area an authentic Korean experience of relaxation, rejuvenation, and escape from the hustle and bustle of daily life.</p><p>At King Spa Virginia, all our amenities are inspired by genuine Korean saunas using infrared heat. Visit us today and indulge in our authentic Korean spa experience!</p>"},{"_type":"widget","_key":"3c0f81d","wtype":"button.default","cls":"elementor-element elementor-element-3c0f81d elementor-align-center elementor-widget elementor-widget-button","attrs":{"data-id":"3c0f81d","data-element_type":"widget","data-e-type":"widget","data-widget_type":"button.default"},"html":"<div class=\"elementor-button-wrapper\">\n<a class=\"elementor-button elementor-button-link elementor-size-lg\" href=\"/contact-us/\">\n<span class=\"elementor-button-content-wrapper\">\n<span class=\"elementor-button-text\">Contact Us</span>\n</span>\n</a>\n</div>"}],"wrapCls":"elementor-widget-wrap elementor-element-populated"}],"containerCls":"elementor-container elementor-column-gap-wider"}]}],"nav":{"menu-item-17735":{"cls":"menu-item menu-item-type-post_type menu-item-object-page current-page-ancestor current-menu-ancestor current-menu-parent current-page-parent current_page_parent current_page_ancestor menu-item-has-children parent hfe-has-submenu hfe-creative-menu","ariaCurrent":null},"menu-item-17747":{"cls":"menu-item menu-item-type-post_type menu-item-object-page current-menu-item page_item page-item-6740 current_page_item menu-item-has-children hfe-has-submenu hfe-creative-menu","ariaCurrent":null,"linkActive":true}}}